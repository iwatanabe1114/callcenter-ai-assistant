# このファイルを secrets.toml にコピーして値を埋めてください。
# secrets.toml は .gitignore 済みです（5.3 秘密情報の管理）。
# Streamlit Community Cloud にデプロイする場合は、アプリ設定の
# 「Secrets」欄にこの中身をそのまま貼り付けます。

# ── AI（LLM） ───────────────────────────────────────────
anthropic_api_key = "sk-ant-..."


# ── ログイン用パスワード（5.1） ─────────────────────────
[passwords]
# チャット画面。空文字にすると認証なしで使えます
chat = ""
# 管理画面（資料の再取得・利用状況）
admin = "change-me-admin"

# ── テナント（5.4 複数会社・ブランドの混在対策） ────────
[tenant]
# このアプリが扱う会社・ブランドの識別番号
id = "default"
# アプリ側の二重チェックで許可する識別番号（想定外の値は除外する）
allowed_ids = ["default"]

# ── キャッシュ（6.1 更新頻度） ──────────────────────────
[cache]
# 何時間経ったら「古い」とみなすか。業務のペースに合わせて決めること
ttl_hours = 24

# ── LLM 設定 ────────────────────────────────────────────
[llm]
answer_model = "claude-sonnet-5"
expansion_model = "claude-haiku-4-5"
effort = "medium"            # low | medium | high | xhigh | max
answer_max_tokens = 8000

# ── 検索設定（4.3 クエリ拡張の重み分離） ────────────────
[search]
# 元の質問に出てきた言葉の重み
original_term_weight = 1.0
# AIが追加した言葉の重み（低くしないと精度が落ちる）
expanded_term_weight = 0.35
top_k = 6

# ── Google スプレッドシート認証 ─────────────────────────
# サービスアカウントのJSONの中身をそのまま貼り付けます。
# 対象スプレッドシートを、このサービスアカウントのメールアドレスに共有しておくこと。
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"

# ── データ取得元（ジャンルごとに1つ） ───────────────────
# genre は campaign / manual / price / product / case のいずれか
#   campaign = キャンペーン・施策   manual = マニュアル
#   price    = 料金表               product = 商品リスト
#   case     = 過去の対応事例（本社確認判断で使う）
#
# columns に書いた列だけを読み込みます（5.2 使う列だけを決めておく）。
# ここに書かなかった列（お客様氏名・電話番号など）はアプリに一切入りません。

[[sources]]
genre = "manual"
spreadsheet_id = "1AbCdEf..."
worksheet = "マニュアル"
columns = ["タイトル", "本文", "カテゴリ", "更新日"]
title_columns = ["タイトル"]
body_columns = ["本文", "カテゴリ"]
# 複数会社が混在するシートの場合だけ指定（5.4）
# tenant_column = "ブランド"
# セルの色・太字も意味を持つ場合は true（8.1）
read_formatting = false

[[sources]]
genre = "campaign"
spreadsheet_id = "1AbCdEf..."
worksheet = "施策"
columns = ["施策名", "内容", "開始日", "終了日"]
title_columns = ["施策名"]
body_columns = ["内容", "開始日", "終了日"]

[[sources]]
genre = "price"
spreadsheet_id = "1AbCdEf..."
worksheet = "料金表"
columns = ["プラン名", "金額", "備考"]
title_columns = ["プラン名"]
body_columns = ["金額", "備考"]

[[sources]]
genre = "product"
spreadsheet_id = "1AbCdEf..."
worksheet = "商品"
columns = ["商品名", "説明", "型番"]
title_columns = ["商品名"]
body_columns = ["説明", "型番"]

[[sources]]
genre = "case"
spreadsheet_id = "1AbCdEf..."
worksheet = "本社確認履歴"
# 8.2 やり取りは全部、時間の順番のまま残す。回答1〜3を全部読み込む
columns = ["件名", "状況", "回答1", "回答2", "最終回答", "確定区分", "日付"]
title_columns = ["件名"]
body_columns = ["状況", "回答1", "回答2", "最終回答", "確定区分", "日付"]
